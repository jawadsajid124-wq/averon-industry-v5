rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'jawadsajid274@gmail.com' ||
        request.auth.token.email == 'jawadsajid124@gmail.com' ||
        (request.auth.token.phone_number != null && (
          request.auth.token.phone_number == '+923056674374' ||
          request.auth.token.phone_number == '+92 305 6674374'
        )) ||
        exists(/databases/$(database)/documents/roles_super_owner/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/system/ownership) && (
          get(/databases/$(database)/documents/system/ownership).data.owner1Uid == request.auth.uid ||
          get(/databases/$(database)/documents/system/ownership).data.owner2Uid == request.auth.uid ||
          get(/databases/$(database)/documents/system/ownership).data.ownerUid == request.auth.uid
        ))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Dual Super Owner System Sovereignty
    // Strictly accessible ONLY by the two verified Super Owners.
    match /system/ownership {
      allow read: if isSuperOwner();
      allow write: if isSuperOwner();
    }

    // 2. Super Owner Role Document
    match /roles_super_owner/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.auth.uid == uid 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'SUPER_OWNER'
        && (!exists(/databases/$(database)/documents/system/ownership) 
            || get(/databases/$(database)/documents/system/ownership).data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperOwner();
    }

    // 3. Team Management (Admins & Owners)
    // Only verified Super Owner has authority to create, update, change roles, revoke, or delete team members.
    // Team members can view their own record if signed in.
    match /team_members/{memberId} {
      allow read: if isSuperOwner() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSuperOwner()
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 128
        && request.resource.data.role in ['ADMIN', 'OWNER']
        && request.resource.data.status in ['ACTIVE', 'INVITED', 'REVOKED'];
      allow update: if isSuperOwner()
        && request.resource.data.role in ['ADMIN', 'OWNER']
        && request.resource.data.status in ['ACTIVE', 'INVITED', 'REVOKED'];
      allow delete: if isSuperOwner();
    }

    // 4. Products Catalog (Read by public, Write only by Super Owner / Authorized Management)
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // 5. Boutique Global Settings (Read by public, Write only by Super Owner)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }
  }
}
